generator client {
  provider = "prisma-client-js"
  output   = "../prisma/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RequestType {
  GRANT_ACCESS
  REVOKE_ACCESS
}

enum LogAction {
  REGISTRATION
  LOGIN
  LOGOUT
  REQUEST_CREATED
}

enum AccessLevel {
  ADMIN
  USER
}

model AccessToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique @db.VarChar(512)
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique @db.VarChar(512)
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  email     String   @unique
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model Log {
  id         Int       @id @default(autoincrement())
  accountId  Int
  action     LogAction
  actionTime DateTime  @db.Timestamp(6)
  user       User      @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model Request {
  id          Int           @id @default(autoincrement())
  name        String        @db.VarChar(40)
  surname     String        @db.VarChar(40)
  middleName  String        @db.VarChar(40)
  email       String        @db.VarChar(255)
  status      RequestStatus
  createDate  DateTime      @db.Timestamp(6)
  requestType RequestType
  resourceId  Int
  roleId      Int
  resource    Resource      @relation(fields: [resourceId], references: [id])
  role        Role          @relation(fields: [roleId], references: [id])
  users       User[]
}

model Resource {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(100)
  description String    @db.VarChar(255)
  link        String    @db.VarChar(255)
  owner       String    @db.VarChar(255)
  requests    Request[]
  roles       Role[]
}

model Role {
  id          Int       @id @default(autoincrement())
  name        String    @unique @db.VarChar(100)
  description String    @db.VarChar(255)
  resourceId  Int
  requests    Request[]
  resource    Resource  @relation(fields: [resourceId], references: [id])
  users       User[]
}

model User {
  id            Int            @id @default(autoincrement())
  email         String         @unique @db.VarChar(255)
  password      String         @db.VarChar(100)
  name          String?        @db.VarChar(40)
  surname       String?        @db.VarChar(40)
  middleName    String?        @db.VarChar(40)
  phone         String?        @db.VarChar(20)
  avatarUrl     String?        @default("/avatar.png")
  birthDate     DateTime?
  subdivision   String?        @db.VarChar(80)
  rang          String?        @db.VarChar(80)
  serviceNumber Int?           @unique
  accessLevel   AccessLevel    @default(USER)
  roleId        Int?
  logs          Log[]
  role          Role?          @relation(fields: [roleId], references: [id], onDelete: Restrict)
  requests      Request[]
  accessTokens  AccessToken[]
  refreshTokens RefreshToken[]

  @@index([id])
}
